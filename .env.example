# Customer dashboard
VITE_API_URL=http://127.0.0.1:8080
# For a same-origin production web image, build with VITE_API_URL=/

# Exposed control plane
CONTROL_PLANE_ADDR=127.0.0.1:8080
CONTROL_PLANE_MODE=local
CONTROL_PLANE_STATE=.local/control-plane/state.json
HOST_AGENT_URL=http://127.0.0.1:9090
# CONTROL_PLANE_API_KEY=replace-me
PUBLIC_API_URL=http://127.0.0.1:8080
PUBLIC_WEB_URL=http://127.0.0.1:5173
PUBLIC_PREVIEW_BASE_URL=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Required in hosted mode. Generate independently, store in Secret Manager,
# and back it up; rotating it requires re-encrypting existing agent credentials.
CONTROL_PLANE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Customer identity. Hosted mode requires a strong session secret and an
# explicit GitHub allowlist until organization/project tenancy is implemented.
CUSTOMER_SESSION_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_ALLOWED_GITHUB_LOGINS=your-github-login
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Local Compose sets this explicitly. Never enable it outside local mode.
ALLOW_INSECURE_LOCAL_AUTH=0

# Server-side connector broker. COMPOSIO_API_KEY is a platform secret: never
# expose it through VITE_* variables or inject it into customer sandboxes.
CONNECTOR_BROKER_URL=http://127.0.0.1:7070
CONNECTOR_BROKER_TOKEN=replace-with-a-random-internal-token
CONNECTOR_BROKER_STATE=.local/connector-broker/state.json
COMPOSIO_API_KEY=

# Server-side model used only to turn marketplace intent into reviewable image
# source. This is a platform credential, never injected into customer images.
# IMAGE_GENERATOR_API_URL may point at any OpenAI-compatible chat-completions
# endpoint. Local Ollama example:
# IMAGE_GENERATOR_API_URL=http://127.0.0.1:11434/api/chat
# IMAGE_GENERATOR_MODEL=llama3.2:3b
IMAGE_GENERATOR_API_URL=
IMAGE_GENERATOR_API_KEY=
IMAGE_GENERATOR_MODEL=

# Owner-only operator console and private API.
# Local defaults are documented for development; hosted mode requires explicit
# values and should use ADMIN_PASSWORD_SHA256 instead of ADMIN_PASSWORD.
ADMIN_EMAIL=owner@agentpop.local
ADMIN_PASSWORD=agentpop-local-owner
# ADMIN_PASSWORD_SHA256=<64-character-sha256>
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Private data plane host agent. The browser never receives this token.
HOST_AGENT_TOKEN=replace-with-a-random-host-token
HOST_AGENT_ADDR=127.0.0.1:9090
HOST_ID=local-docker
HOST_NAME=Local Docker data plane
HOST_REGION=local
HOST_STATE_DIR=.local/host-agent
RUNTIME_DRIVER=auto
DOCKER_SANDBOX_IMAGE=agentpop/devbox:local
SANDBOX_SSH_KEY=.local/ssh/id_ed25519

# Linux KVM / Firecracker host
FIRECRACKER_BINARY=/usr/local/bin/firecracker
JAILER_BINARY=/usr/local/bin/jailer
FIRECRACKER_KERNEL=/var/lib/agentpop/assets/vmlinux
FIRECRACKER_ROOTFS=/var/lib/agentpop/assets/devbox.ext4
FIRECRACKER_STATE_DIR=/var/lib/agentpop
FIRECRACKER_RUNTIME_HELPER=/usr/local/libexec/agentpop-firecracker
