ACME_EMAIL=ops@agentpop.cloud
ALPHA_USER=agentpop
# Generate with: docker run --rm caddy:2-alpine caddy hash-password
# Keep the bcrypt hash in single quotes so Compose does not interpolate "$".
ALPHA_PASSWORD_HASH='$2a$14$replace_with_a_caddy_hash'

AGENTPOP_WEB_IMAGE=us-west1-docker.pkg.dev/PROJECT_ID/agentpop/web:VERSION
AGENTPOP_CONTROL_PLANE_IMAGE=us-west1-docker.pkg.dev/PROJECT_ID/agentpop/control-plane:VERSION
AGENTPOP_CONNECTOR_BROKER_IMAGE=us-west1-docker.pkg.dev/PROJECT_ID/agentpop/connector-broker:VERSION

CONTROL_PLANE_API_KEY=replace-with-a-random-customer-gateway-key
CONTROL_PLANE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@agentpop.cloud
ADMIN_PASSWORD_SHA256=replace-with-a-64-character-sha256
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_SESSION_SECRET=replace-with-at-least-32-random-characters
# Hosted alpha is deliberately single-tenant until project scoping ships.
# Comma-separated GitHub logins; an empty value fails closed outside local mode.
CUSTOMER_ALLOWED_GITHUB_LOGINS=your-github-login
GITHUB_OAUTH_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-your-github-oauth-client-secret

CONNECTOR_BROKER_TOKEN=replace-with-a-random-internal-token
COMPOSIO_API_KEY=replace-with-your-server-side-composio-platform-key

# Private platform model used for intent-to-image source generation.
IMAGE_GENERATOR_API_URL=https://api.openai.com/v1/chat/completions
IMAGE_GENERATOR_API_KEY=replace-with-your-server-side-model-key
IMAGE_GENERATOR_MODEL=gpt-4.1-mini

HOST_AGENT_URL=http://PRIVATE_DATA_PLANE_IP:9090
HOST_AGENT_TOKEN=replace-with-the-same-random-token-used-by-the-host
